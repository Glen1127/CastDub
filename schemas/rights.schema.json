{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://castdub.local/schemas/rights.schema.json",
  "title": "Rights manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_title",
    "translation_approved",
    "dubbing_approved",
    "overseas_distribution_approved",
    "voice_grants"
  ],
  "properties": {
    "source_title": { "type": "string", "minLength": 1 },
    "translation_approved": { "const": true },
    "dubbing_approved": { "const": true },
    "overseas_distribution_approved": { "const": true },
    "voice_grants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "character_id",
          "voice_cloning_approved",
          "cross_language_approved",
          "permitted_target_languages"
        ],
        "properties": {
          "character_id": { "type": "string", "minLength": 1 },
          "voice_cloning_approved": { "const": true },
          "cross_language_approved": { "const": true },
          "permitted_target_languages": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 2 },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
