{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://castdub.local/schemas/role-mapping.schema.json",
  "title": "Approved episode role mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "approved",
    "authorized_characters",
    "assignments"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "job_id": { "type": "string", "minLength": 1 },
    "approved": { "const": true },
    "authorized_characters": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["segment_id", "approved_character_id"],
        "properties": {
          "segment_id": { "type": "string", "minLength": 1 },
          "approved_character_id": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
