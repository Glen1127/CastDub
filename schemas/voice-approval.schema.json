{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://castdub.local/schemas/voice-approval.schema.json",
  "title": "Episode character voice approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "library_root", "approved", "characters"],
  "properties": {
    "schema_version": { "const": 1 },
    "job_id": { "type": "string", "minLength": 1 },
    "library_root": { "type": "string", "minLength": 1 },
    "approved": { "const": true },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["character_id", "selection", "approved"],
        "properties": {
          "character_id": { "type": "string", "minLength": 1 },
          "selection": {
            "type": "object",
            "required": ["mode", "segment_id"],
            "properties": {
              "mode": { "enum": ["reuse_existing", "episode_reference"] },
              "segment_id": { "type": ["string", "null"] }
            }
          },
          "approved": { "const": true }
        }
      }
    }
  }
}
